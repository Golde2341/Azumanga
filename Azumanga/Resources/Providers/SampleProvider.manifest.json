{
  "apiVersion": 1,
  "id": "com.example.mangadex-js",
  "name": "MangaDex (example JS provider)",
  "version": "1.0.0",
  "main": "index.js",
  "language": "en",
  "allowedHosts": [
    "api.mangadex.org",
    "uploads.mangadex.org",
    "*.mangadex.network"
  ],
  "capabilities": [
    "search",
    "popular",
    "latest",
    "filters",
    "chapters",
    "pages"
  ],
  "config": [
    {
      "key": "quality",
      "label": "Image quality",
      "type": "select",
      "options": ["data-saver", "data"],
      "default": "data-saver"
    },
    {
      "key": "language",
      "label": "Translated language",
      "type": "text",
      "default": "en"
    }
  ],
  "homepage": "https://api.mangadex.org/docs/"
}
